# =====================================================================
# POSTYAR — environment variable template (placeholders only)
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your deployment.
# NEVER commit the real `.env` to git (it is gitignored).
# All values below are PLACEHOLDERS — replace before production use.
# =====================================================================

# --- Database (production: MariaDB 10 via mysql provider) ---
# Development (SQLite, file-based):
DATABASE_URL="file:./dev.db"
# Production (MariaDB 10) — uncomment and fill:
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/postyar?charset=utf8mb4"

# --- Redis (production: REAL Redis — addendum §3) ---
# Leave unset in dev to use the in-memory fallback (single-process only).
# Set in production for distributed locks, rate limiting, OTP throttling,
# idempotency, queue coordination, duplicate suppression.
# REDIS_URL="redis://127.0.0.1:6379/0"

# --- Master encryption key (64 hex chars = 32 bytes) ---
# Generate with: openssl rand -hex 32
# Used for AES-256-GCM encryption of provider tokens at rest.
POSTYAR_MASTER_KEY="REPLACE_WITH_64_HEX_CHARS"

# --- JWT session signing secret (>= 32 chars) ---
# Generate with: openssl rand -hex 32
POSTYAR_JWT_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"

# --- Cron secret (protects /api/publish/run, /api/bots/*/poll, etc.) ---
# Generate with: openssl rand -hex 32
POSTYAR_CRON_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"

# --- Public base URL (your HTTPS origin) ---
# این مقدار در محیط تولید الزامی است — نشانی واقعی HTTPS سرویس را وارد کنید.
# MUST be set in production (your real HTTPS origin, e.g. https://postyar.ir).
# NEVER ship a placeholder as the value: placeholder/example.com values are
# treated as UNSET by the code (isPlaceholderSecret), so webhook registration
# would fail closed in production. Leave it empty for dev/preview — webhook
# registration then degrades to the localhost fallback + cron poll route.
POSTYAR_PUBLIC_BASE_URL=""

# --- Bank gateway (direct) ---
POSTYAR_BANK_DIRECT_URL="https://bank-gateway.example.com"
POSTYAR_BANK_DIRECT_MERCHANT="REPLACE_MERCHANT_CODE"
POSTYAR_BANK_DIRECT_TERMINAL="REPLACE_TERMINAL_ID"
POSTYAR_BANK_DIRECT_SECRET="REPLACE_BANK_DIRECT_SECRET"

# --- Bank gateway (intermediary) ---
POSTYAR_BANK_INTERMEDIARY_URL="https://intermediary.example.com"
POSTYAR_BANK_INTERMEDIARY_MERCHANT="REPLACE_MERCHANT_CODE"
POSTYAR_BANK_INTERMEDIARY_SECRET="REPLACE_BANK_INTERMEDIARY_SECRET"

# --- Bank callback path (relative) ---
POSTYAR_BANK_CALLBACK_PATH="/api/payments/bank/callback"

# --- SMS provider (OTP + notifications) ---
POSTYAR_SMS_PROVIDER="kavenegar"  # or "farapayamak", "melipayamak"
POSTYAR_SMS_API_KEY="REPLACE_SMS_API_KEY"
POSTYAR_SMS_USERNAME="REPLACE_SMS_USERNAME"
POSTYAR_SMS_PASSWORD="REPLACE_SMS_PASSWORD"
POSTYAR_SMS_SENDER="REPLACE_SMS_SENDER_NUMBER"
POSTYAR_SMS_TEMPLATE_ID="REPLACE_SMS_TEMPLATE_ID"

# --- SMTP (email notifications) ---
POSTYAR_SMTP_HOST="smtp.example.com"
POSTYAR_SMTP_PORT="587"
POSTYAR_SMTP_USER="REPLACE_SMTP_USER"
POSTYAR_SMTP_PASSWORD="REPLACE_SMTP_PASSWORD"
POSTYAR_SMTP_SENDER_EMAIL="noreply@example.com"
POSTYAR_SMTP_SENDER_NAME="پُست‌یار"

# --- Gold price provider ---
POSTYAR_GOLD_PROVIDER_URL="https://gold-provider.example.com/api"

# --- AI provider (optional; postyar-zai built-in always available) ---
POSTYAR_AI_OLLAMA_URL="http://127.0.0.1:11434"

# --- Referral program ---
POSTYAR_REFERRAL_PERCENT="10"
POSTYAR_REFERRAL_CAP_RIALS="100000000"

# --- Media upload limits (MB) ---
POSTYAR_MAX_VIDEO_MB="50"
